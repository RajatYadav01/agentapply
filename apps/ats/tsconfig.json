{
	"extends": "@agentapply/tsconfig/nodejs.json",
	"compilerOptions": {
		"types": ["node", "vitest/globals"],
		"paths": {
			"@/*": ["./src/*"]
		},
		"rootDir": ".",
		"outDir": "./dist"
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "vitest.config.ts", "vitest.setup.ts"]
}
