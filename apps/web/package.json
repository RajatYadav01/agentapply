		"@vitest/coverage-v8": "^4.1.8",
		"@vitest/ui": "^4.1.8",
		"babel-plugin-react-compiler": "^1.0.0",
		"globals": "^17.6.0",
		"jsdom": "^29.1.1",
		"vite": "^8.1.0",
		"vitest": "^4.1.8"
