{
	"name": "@agentapply/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:report": "eslint . --format json --output-file lint-report.json || true",
		"preview": "vite preview",
		"test": "vitest",
		"test:unit": "vitest run unit.test.ts --passWithNoTests",
		"test:integration": "vitest run integration.test.ts --passWithNoTests",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest --watch"
	},
	"dependencies": {
