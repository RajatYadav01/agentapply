		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@agentapply/config": "workspace:*",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"pg": "^8.22.0"
	},
	"devDependencies": {
		"@agentapply/tsconfig": "workspace:*",
		"@types/pg": "^8.20.0",
		"prisma": "^7.8.0"
	}
