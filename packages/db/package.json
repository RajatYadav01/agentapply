{
	"name": "@agentapply/db",
	"version": "0.0.0",
	"private": true,
	"sideEffects": false,
	"license": "UNLICENSED",
	"type": "module",
	"main": "./dist/src/index.js",
	"types": "./dist/src/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"import": "./dist/src/index.js",
			"default": "./dist/src/index.js"
		}
	},
	"scripts": {
		"dev": "prisma generate && prisma migrate dev",
