# ==========================================
# ENVIRONMENT & RUNTIME CONFIGURATION
# ==========================================
# Runtime environment ('development', 'staging', or 'production')
NODE_ENV=development

# Application logging level ('fatal', 'error', 'warn', 'info', 'debug', 'trace')
LOG_LEVEL=info

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# PostgreSQL connection string used by Prisma (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE)
DATABASE_URL=postgresql://agentapply:1751420@localhost:5432/agentapply

# ==========================================
# API APP SERVICE (apps/api)
# ==========================================
# Port on which the API gateway HTTP server listens
API_PORT=3000

# Base public URL for API endpoints (used for internal client routing and web app communication)
API_URL=http://localhost:3000/api/v1

# ==========================================
# BROWSER AGENT SERVICE (apps/agent)
# ==========================================
# Port on which the Stagehand automation worker process runs
AGENT_PORT=4000

# Endpoint URL where the Agent service accepts application job dispatches
AGENT_URL=http://localhost:4000/agent/v1

# Controls browser execution mode (false = show Playwright browser UI for debugging, true = run headless in background)
STAGEHAND_HEADLESS=false

# Directory path where browser failure screenshots and step logs will be stored
SCREENSHOT_DIRECTORY=screenshots

# ==========================================
# MOCK ATS SERVICE (apps/ats)
# ==========================================
# Port on which the local Mock Applicant Tracking System service runs
ATS_PORT=5000

# Base URL pointing to the local sandbox ATS job application forms
ATS_URL=http://localhost:5000/ats

# ==========================================
# REACT FRONTEND WEB APP (apps/web)
# Note: Vite environment variables are embedded into static bundles at build time
# ==========================================
# Base path for client-side routing and asset serving
VITE_BASE_URL=/

# Target API gateway URL called by the React frontend
VITE_API_URL=http://localhost:3000/api/v1

# Target ATS URL used by the frontend for sandbox testing links
VITE_ATS_URL=http://localhost:5000/ats